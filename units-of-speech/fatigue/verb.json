{"transcript":"fa.tiɡ","exists":true,"definitions":["Causer de la fatigue à quelqu'un, à un animal, à un organe, l'épuiser.","Lasser, ennuyer quelqu'un.","Affaiblir, user quelque chose par un effort prolongé."],"examples":["Ce travail me fatigue.","La chaleur fatigue les organismes.","Il fatigue son cheval.","Cette musique fatigue les oreilles."],"lemma":"fatiguer","lemmaPos":"verb","synonyms":["épuiser","lasser","harasser","exténuer","éreinter"],"number":"singular","tense":"present","pastTenses":"fatigua (past simple), a fatigué (present perfect)","source":"fatigue","frequency":3}