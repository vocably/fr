{"transcript":"p\nɛ\n.\nʁy\nʃ","exists":true,"definitions":["Oiseau grimpeur de la famille des psittacidés, à longue queue, au plumage généralement vert, souvent élevé en cage.","Familier. Personne bavarde et écervelée."],"examples":["Une perruche ondulée.","Elle jacasse comme une perruche."],"lemma":"perruche","lemmaPos":"noun","synonyms":["psittacidé","bavarde","pipelette"],"number":"singular","pluralForm":"les perruches","gender":"feminine","source":"perruche","frequency":3}